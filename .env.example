# GROQ_API_KEY: Required for Groq AI API calls (free tier available).
# Users configure this via environment variables or a .env.local file.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL: Optional override for the Groq model.
# Defaults to llama-3.1-8b-instant if not set.
# GROQ_MODEL="llama-3.1-8b-instant"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
